---
import { gameGuideTitle, type CatalogGame } from "../lib/catalog";
interface Props {
  game: CatalogGame;
  href: string;
  showGuideTitle?: boolean;
  locale: "en" | "he";
}
const { game, href, locale, showGuideTitle } = Astro.props;
const cover = game.covers[locale].src || game.covers[locale === "en" ? "he" : "en"].src;
const title = locale === "he" ? game.title_he || game.title : game.title;
---

<div class="game-card">
  <a href={href}>
    <img class="game-cover" src={cover} alt="" width="220" height="290" loading="lazy" decoding="async" />
    <h2 class="game-title"><bdi>{showGuideTitle ? gameGuideTitle(game, locale) : title}</bdi></h2>
  </a>
  <slot />
</div>

<style>
  .game-card {
    display: grid;
    gap: 12px;
    padding: 14px 12px;
    background: #101b2b;
    border: 1px solid #263545;
    border-radius: 8px;
    color: inherit;
    text-align: center;
    text-decoration: none;
  }

  .game-card:hover,
  .game-card:focus-within {
    border-color: var(--teal);
  }

  .game-card > a {
    color: inherit;
    text-decoration: none;
  }

  .game-cover {
    display: block;
    width: min(100%, 220px);
    height: auto;
    aspect-ratio: 22 / 29;
    object-fit: contain;
    margin-inline: auto;
  }

  .game-title {
    margin: 12px 0 0;
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
</style>
