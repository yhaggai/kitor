---
import Box from "../components/Box";
import Character from "../components/Character.astro";
import Layout from "../layouts/Layout.astro";
import { featured, games } from "../lib/catalog";
import { fallbackInstallerUrl, fallbackReleaseUrl, installers } from "../lib/downloads";
---
<Layout><main id="main"><section class="hero"><div class="scene" aria-hidden="true"></div><div class="hero-content wrap"><div class="hero-copy"><p class="eyebrow">הרפתקאות מוכרות. מילים חדשות.</p><h1>המשחקים שאהבת.<br/><em>עכשיו בעברית.</em></h1><p class="lead">כל המשחקים והתרגומים במקום אחד.<br/>מוסיפים לספרייה, מתקינים תרגום ומתחילים לשחק.</p><div class="actions"><a class="button" id="recommended-download" href="#download"><span>להורדת קיטור</span> <span aria-hidden="true">↓</span></a><a class="button secondary" href="#download" hidden>כל הגרסאות</a></div><a class="text-link" href="/games/">לכל המשחקים <span aria-hidden="true">←</span></a><p class="quiet hero-note">המשחקים שלכם. התרגומים של הקהילה. מקום אחד לכולם.</p></div><div class="shelves" aria-label="מבחר מתוך ספריית המשחקים"><div class="shelf">{featured.slice(0,3).map(game => <Box title={game.title} covers={game.covers} showLanguageControls={false} client:load />)}</div><div class="shelf lower">{featured.slice(3).map(game => <Box title={game.title} covers={game.covers} showLanguageControls={false} client:load />)}</div><p class="shelf-caption">העבירו את העכבר כדי להפוך קופסה · לחצו כדי להסתכל מקרוב</p></div></div><Character kind="pirate" side="left"/></section>
<section id="how" class="section how"><div class="wrap"><p class="eyebrow">פחות הגדרות, יותר הרפתקאות</p><h2>ההרפתקה מתחילה כאן</h2><div class="steps"><article><span class="step-icon">▣</span><span class="number">01</span><h3>מוסיפים משחקים</h3><p>מאתרים את המשחקים שכבר נמצאים במחשב ומוסיפים אותם לספרייה שלכם.</p></article><article><span class="step-icon">א</span><span class="number">02</span><h3>מתקינים תרגום</h3><p>בוחרים תרגום זמין מהקהילה. קיטור מנהל את ההתקנה ואת גיבוי הקבצים שהשתנו.</p></article><article><span class="step-icon">✦</span><span class="number">03</span><h3>מתחילים לשחק</h3><p>פותחים את המשחק מתוך הספרייה, וחוזרים לעולמות שאוהבים — בעברית.</p></article></div></div><Character kind="tentacle" side="right"/></section>
<section class="section collection wrap"><div><p class="eyebrow">מדף מלא בזיכרונות</p><h2>איזו הרפתקה<br/>נפתח היום?</h2><p class="lead">ממסע בחלל ועד אי הקופים —<br/>{games.length} משחקים מחכים לכם בספרייה הנתמכת.</p><a class="button secondary" href="/games/">לכל המשחקים <span aria-hidden="true">←</span></a></div><div class="collection-art"><Box title={featured[2].title} covers={featured[2].covers} client:visible/><Box title={featured[4].title} covers={featured[4].covers} client:visible/></div></section>
<section id="community" class="section community"><div class="wrap narrow"><p class="eyebrow">מאהבה למשחקים. ומאהבה לעברית.</p><h2>מאחורי כל תרגום,<br/>יש אנשים שאוהבים את המשחק.</h2><p class="lead">קיטור מחבר בין המשחקים שלכם לעבודה של קהילת המתרגמים. הקרדיט על התרגומים שייך ליוצרים שלהם — אנחנו כאן כדי שיהיה קל יותר לגלות אותם ולשחק.</p><a class="text-link" href="https://github.com/yhaggai/kitor">להכיר את הפרויקט ב־GitHub ↗</a></div><Character kind="space" side="left"/></section>
<section id="download" class="section wrap download" aria-labelledby="download-title">
  <p class="eyebrow">מוכנים לחזור להרפתקה?</p>
  <h2 id="download-title">המדף שלכם מחכה.</h2>
  <p class="lead">בחרו את גרסת קיטור המתאימה למחשב שלכם.</p>
  <div class="download-platforms">
    <div id="windows-download" tabindex="-1">
      <h3><bdi>Windows</bdi></h3>
      <a class="button secondary" data-installer={installers[0].id} href={fallbackInstallerUrl(installers[0].id)}>להורדה · <bdi>x64</bdi></a>
    </div>
    <div id="mac-downloads" tabindex="-1">
      <h3><bdi>macOS</bdi></h3>
      <a class="button secondary" data-installer={installers[1].id} href={fallbackInstallerUrl(installers[1].id)}>להורדה · <bdi>Apple Silicon (ARM64)</bdi></a>
      <a class="button secondary" data-installer={installers[2].id} href={fallbackInstallerUrl(installers[2].id)}>להורדה · <bdi>Intel</bdi></a>
      <p class="quiet">לא בטוחים? בתפריט , פתחו את ״אודות Mac זה״ ובדקו מה מופיע ליד ״שבב״ או ״מעבד״.</p>
    </div>
  </div>
  <a class="text-link" id="app-releases" href={fallbackReleaseUrl}>לעמוד ההפצות ב־GitHub <span aria-hidden="true">↗</span></a>
</section>
<section class="faq wrap"><h2>לפני שמתחילים</h2><details><summary>האם קיטור כולל את המשחקים?</summary><p>לא. צריך עותק משלכם של המשחק. קיטור מרכז את הספרייה ומאפשר להתקין תרגומים למשחקים הנתמכים.</p></details><details><summary>האם כל משחק עובד בכל מערכת הפעלה?</summary><p>התמיכה משתנה ממשחק למשחק ומגרסה לגרסה. בגלריה מופיעות מערכות ההפעלה שבקטלוג; דרישות נוספות והנחיות מופיעות באפליקציה.</p></details><details><summary>אפשר להסיר תרגום?</summary><p>קיטור מגבה את הקבצים שהתרגום משנה ועוקב אחרי קבצים שנוספו, כדי לאפשר שחזור. מומלץ לסגור את המשחק לפני התקנה או הסרה.</p></details></section></main></Layout>

<script>
  import { detectDownload, installers, latestInstallers, releasesUrl } from "../lib/downloads";

  const recommended = document.querySelector<HTMLAnchorElement>("#recommended-download");
  const label = recommended?.querySelector("span");
  const allVersions = document.querySelector<HTMLAnchorElement>("#recommended-download + a");
  const releaseLink = document.querySelector<HTMLAnchorElement>("#app-releases");
  const published = latestInstallers().catch(() => undefined);

  void published.then((release) => {
    if (!release) return;
    for (const [id, url] of release.urls) {
      const link = document.querySelector<HTMLAnchorElement>(`[data-installer="${id}"]`);
      if (link) link.href = url;
    }
    if (releaseLink) releaseLink.href = `${releasesUrl}/tag/app-v${release.version.join(".")}`;
  });

  void detectDownload(navigator).then(async (detected) => {
    if (!detected || !recommended || !label) return;
    const mac = detected === "mac" || detected.startsWith("darwin-");
    const installer = installers.find(({ id }) => id === detected);
    label.replaceChildren("הורדה ל־");
    const platform = document.createElement("bdi");
    platform.textContent = installer?.label ?? (mac ? "macOS" : "Windows");
    label.append(platform);
    recommended.href = mac ? "#mac-downloads" : "#windows-download";
    if (allVersions) allVersions.hidden = false;

    const url = installer && (await published)?.urls.get(installer.id);
    if (url) recommended.href = url;
  });
</script>
