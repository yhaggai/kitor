---
import Layout from "../layouts/Layout.astro";
import { featured, games } from "../lib/catalog";
import { fallbackInstallerUrl, fallbackReleaseUrl, installers } from "../lib/downloads";
import Box from "./Box";
import Character from "./Character.astro";

const { locale } = Astro.props as { locale: "he" | "en" };
const en = locale === "en";
const t = (hebrew: string, english: string) => (en ? english : hebrew);
---
<Layout locale={locale}><main id="main"><section class="hero"><div class="scene" aria-hidden="true"></div><div class="hero-content wrap"><div class="hero-copy"><p class="eyebrow">{t("הרפתקאות מוכרות. מילים חדשות.", "Familiar adventures. New words.")}</p><h1>{t("המשחקים שאהבת.", "The games you loved.")}<br/><em>{t("עכשיו בעברית.", "Now in Hebrew.")}</em></h1><p class="lead">{t("כל המשחקים והתרגומים במקום אחד.", "All your games and translations in one place.")}<br/>{t("מוסיפים משחק ומשחקים בעברית. קיטור דואג לתרגום.", "Add a game and play in Hebrew. Kitor takes care of the translation.")}</p><div class="actions"><a class="button" id="recommended-download" href="#download"><span>{t("להורדת קיטור", "Download Kitor")}</span> <span aria-hidden="true">↓</span></a><a class="button secondary" href="#download" hidden>{t("כל הגרסאות", "All versions")}</a></div><a class="text-link" href={en ? "/en/games/" : "/games/"}>{t("לכל המשחקים", "Browse all games")} <span aria-hidden="true">{en ? "→" : "←"}</span></a><p class="quiet hero-note">{t("המשחקים שלכם. התרגומים של הקהילה. מקום אחד לכולם.", "Your games and community translations, together.")}</p></div><div class="shelves" aria-label={t("מבחר מתוך ספריית המשחקים", "Featured games from the library")}><div class="shelf">{featured.slice(0,3).map(game => <Box locale={locale} showLanguageControls={false} title={game.title} covers={game.covers} client:load />)}</div><div class="shelf lower">{featured.slice(3).map(game => <Box locale={locale} showLanguageControls={false} title={game.title} covers={game.covers} client:load />)}</div><p class="shelf-caption">{t("העבירו את העכבר כדי להפוך קופסה · לחצו כדי להסתכל מקרוב", "Hover to turn a box around · Click for a closer look")}</p></div></div><Character kind="pirate" side="left"/></section>
<section id="how" class="section how">
  <div class="wrap">
    <p class="eyebrow">{t("פחות הגדרות, יותר הרפתקאות", "Less setup, more adventure")}</p>
    <h2>{t("מוסיפים משחק, וקיטור עושה את הקסם", "Add a game. Kitor does the magic.")}</h2>
    <div class="steps">
      <article>
        <span class="step-icon" aria-hidden="true">↓</span>
        <span class="number">01</span>
        <h3>{t("מוסיפים משחק", "Add a game")}</h3>
        <p>{en
          ? <>Add a supported game from your computer or from your <bdi>Steam</bdi> or <bdi>GOG</bdi> library. Kitor downloads it if needed.</>
          : <>מוסיפים משחק נתמך מהמחשב או מהספרייה שלכם ב־<bdi>Steam</bdi> או ב־<bdi>GOG</bdi>. קיטור מוריד את המשחק במידת הצורך.</>}</p>
      </article>
      <article>
        <span class="step-icon" aria-hidden="true">א</span>
        <span class="number">02</span>
        <h3>{t("קיטור מוסיף תרגום", "Kitor adds the translation")}</h3>
        <p>{t("קיטור מתקין אוטומטית את התרגום שמתאים למשחק ומגבה את הקבצים שהוא משנה.", "Kitor automatically installs the right translation for your game and backs up the files it changes.")}</p>
      </article>
      <article>
        <span class="step-icon" aria-hidden="true">✦</span>
        <span class="number">03</span>
        <h3>{t("משחקים בעברית", "Play in Hebrew")}</h3>
        <p>{t("מפעילים את המשחק מתוך קיטור וחוזרים לעולמות שאוהבים.", "Launch the game from Kitor and return to the worlds you love.")}</p>
      </article>
    </div>
  </div>
  <Character kind="tentacle" side="right" />
</section>
<section class="section collection wrap"><div><p class="eyebrow">{t("מדף מלא בזיכרונות", "A shelf full of memories")}</p><h2>{t("איזו הרפתקה", "What adventure")}<br/>{t("נפתח היום?", "will you play today?")}</h2><p class="lead">{t("ממסע בחלל ועד אי הקופים —", "From Space Quest to Monkey Island,")}<br/>{games.length}{t(" משחקים מחכים לכם בספרייה הנתמכת.", " supported games are waiting for you.")}</p><a class="button secondary" href={en ? "/en/games/" : "/games/"}>{t("לכל המשחקים", "Browse all games")} <span aria-hidden="true">{en ? "→" : "←"}</span></a></div><div class="collection-art"><Box locale={locale} showLanguageControls={false} title={featured[2].title} covers={featured[2].covers} client:visible/><Box locale={locale} showLanguageControls={false} title={featured[4].title} covers={featured[4].covers} client:visible/></div></section>
<section id="community" class="section community"><div class="wrap narrow"><p class="eyebrow">{t("מאהבה למשחקים. ומאהבה לעברית.", "For the love of games and Hebrew.")}</p><h2>{t("מאחורי כל תרגום,", "Behind every translation")}<br/>{t("יש אנשים שאוהבים את המשחק.", "are people who love the game.")}</h2><p class="lead">{t("קיטור מחבר בין המשחקים שלכם לעבודה של קהילת המתרגמים. הקרדיט על התרגומים שייך ליוצרים שלהם — אנחנו כאן כדי שיהיה קל יותר לגלות אותם ולשחק.", "Kitor brings your games and the work of community translators together. The translators deserve the credit for their work. Kitor makes their translations easier to find and play.")}</p><a class="text-link" href="https://github.com/yhaggai/kitor">{t("להכיר את הפרויקט ב־GitHub ↗", "Explore the project on GitHub ↗")}</a></div><Character kind="space" side="left"/></section>
<section id="download" class="section wrap download" aria-labelledby="download-title">
  <p class="eyebrow">{t("מוכנים לחזור להרפתקה?", "Ready for another adventure?")}</p>
  <h2 id="download-title">{t("המדף שלכם מחכה.", "Your shelf awaits.")}</h2>
  <p class="lead">{t("בחרו את גרסת קיטור המתאימה למחשב שלכם.", "Choose the Kitor version for your computer.")}</p>
  <div class="download-platforms">
    <div id="windows-download" tabindex="-1">
      <h3><bdi>Windows</bdi></h3>
      <a class="button secondary" data-installer={installers[0].id} href={fallbackInstallerUrl(installers[0].id)}>{t("להורדה · ", "Download · ")}<bdi>x64</bdi></a>
    </div>
    <div id="mac-downloads" tabindex="-1">
      <h3><bdi>macOS</bdi></h3>
      <a class="button secondary" data-installer={installers[1].id} href={fallbackInstallerUrl(installers[1].id)}>{t("להורדה · ", "Download · ")}<bdi>Apple Silicon (ARM64)</bdi></a>
      <a class="button secondary" data-installer={installers[2].id} href={fallbackInstallerUrl(installers[2].id)}>{t("להורדה · ", "Download · ")}<bdi>Intel</bdi></a>
      <p class="quiet">{t("לא בטוחים? בתפריט , פתחו את ״אודות Mac זה״ ובדקו מה מופיע ליד ״שבב״ או ״מעבד״.", "Unsure? Open About This Mac from the  menu and check the Chip or Processor field.")}</p>
    </div>
  </div>
  <a class="text-link" id="app-releases" href={fallbackReleaseUrl}>{t("לעמוד ההפצות ב־GitHub ", "View releases on GitHub ")}<span aria-hidden="true">↗</span></a>
</section>
<section class="faq wrap"><h2>{t("לפני שמתחילים", "Before you start")}</h2><details><summary>{t("האם קיטור כולל את המשחקים?", "Does Kitor include the games?")}</summary><p>{en ? <>You need your own copy of the game. Kitor can download supported games directly from your <bdi>GOG</bdi> or <bdi>Steam</bdi> library, then automatically install the translation.</> : <>לא. צריך עותק משלכם של המשחק. אם כבר יש לכם משחק נתמך בספרייה של <bdi>GOG</bdi> או <bdi>Steam</bdi>, קיטור יכול להוריד אותו עבורכם ישירות מהחנות, בלי שתצטרכו להוריד אותו בנפרד. לאחר מכן קיטור מתקין את התרגום אוטומטית.</>}</p></details><details><summary>{t("האם כל משחק עובד בכל מערכת הפעלה?", "Does every game work on every operating system?")}</summary><p>{t("התמיכה משתנה ממשחק למשחק ומגרסה לגרסה. בגלריה מופיעות מערכות ההפעלה שבקטלוג; דרישות נוספות והנחיות מופיעות באפליקציה.", "Support varies by game and edition. The catalog lists supported operating systems, and the app provides additional requirements and instructions.")}</p></details><details><summary>{t("אפשר להסיר תרגום?", "Can I remove a translation?")}</summary><p>{t("קיטור מגבה את הקבצים שהתרגום משנה ועוקב אחרי קבצים שנוספו, כדי לאפשר שחזור. מומלץ לסגור את המשחק לפני התקנה או הסרה.", "Kitor backs up changed files and tracks added files so it can restore the original game. Close the game before installing or removing a translation.")}</p></details></section></main></Layout>

<script>
  import { detectDownload, installers, latestInstallers, releasesUrl } from "../lib/downloads";

  const recommended = document.querySelector<HTMLAnchorElement>("#recommended-download");
  const label = recommended?.querySelector("span");
  const allVersions = document.querySelector<HTMLAnchorElement>("#recommended-download + a");
  const releaseLink = document.querySelector<HTMLAnchorElement>("#app-releases");
  const published = latestInstallers().catch(() => undefined);

  void published.then((release) => {
    if (!release) return;
    for (const [id, url] of release.urls) {
      const link = document.querySelector<HTMLAnchorElement>(`[data-installer="${id}"]`);
      if (link) link.href = url;
    }
    if (releaseLink) releaseLink.href = `${releasesUrl}/tag/app-v${release.version.join(".")}`;
  });

  void detectDownload(navigator).then(async (detected) => {
    if (!detected || !recommended || !label) return;
    const mac = detected === "mac" || detected.startsWith("darwin-");
    const installer = installers.find(({ id }) => id === detected);
    label.replaceChildren(document.documentElement.lang === "en" ? "Download for " : "הורדה ל־");
    const platform = document.createElement("bdi");
    platform.textContent = installer?.label ?? (mac ? "macOS" : "Windows");
    label.append(platform);
    recommended.href = mac ? "#mac-downloads" : "#windows-download";
    if (allVersions) allVersions.hidden = false;

    const url = installer && (await published)?.urls.get(installer.id);
    if (url) recommended.href = url;
  });
</script>
