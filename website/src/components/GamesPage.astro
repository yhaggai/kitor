---
import GameCard from "./GameCard.astro";
import Layout from "../layouts/Layout.astro";
import { games } from "../lib/catalog";
const { locale } = Astro.props as { locale: "he" | "en" };
const en = locale === "en";
const catalogPath = en ? "/en/games/" : "/games/";
const t = (hebrew: string, english: string) => (en ? english : hebrew);
---

<Layout
  locale={locale}
  title={t("משחקי מחשב עם תרגום לעברית – קטלוג קיטור", "PC games with Hebrew translations – Kitor catalog")}
  description={t(
    "חפשו משחקי מחשב בקטלוג קיטור ובדקו אילו מהדורות זמינות, אם יש תרגום לעברית ואיך מתחילים לשחק.",
    "Browse the Kitor catalog for game editions, Hebrew patch availability, and how to get started."
  )}
>
  <main id="main" class="wrap catalog">
    <a class="text-link" href={en ? "/en/" : "/"}>{t("→ בחזרה לבית", "← Back to home")}</a>
    <p class="eyebrow">{t("הספרייה של קיטור", "The Kitor library")}</p>
    <h1>{t("משחקי מחשב ותרגומים לעברית", "PC games and Hebrew translations")}</h1>
    <p class="lead">{t("בחרו משחק כדי לבדוק אם יש לו תרגום לעברית ואיך לשחק.", "Choose a game to check Hebrew patch availability and learn how to play.")}</p>
    <div class="filters">
      <label>
        {t("חיפוש משחק", "Search games")}
        <input id="search" type="search" placeholder={t("שם המשחק בעברית או באנגלית…", "Game title in Hebrew or English…")} />
      </label>
    </div>
    <div class="game-grid">
      {games.map((game) => (
        <article class="game-entry" data-title={`${game.title} ${game.title_he ?? ""} ${game.id}`.toLocaleLowerCase("he")}>
          <GameCard game={game} href={catalogPath + game.id + "/"} {locale} showGuideTitle />
        </article>
      ))}
    </div>
    <p id="empty" role="status" hidden>{t("לא נמצאו משחקים מתאימים. נסו שם אחר.", "No matching games. Try another title.")}</p>
  </main>

  <script>
    const search = document.querySelector<HTMLInputElement>("#search")!;
    const entries = document.querySelectorAll<HTMLElement>(".game-entry");
    const empty = document.querySelector<HTMLElement>("#empty")!;

    search.addEventListener("input", () => {
      const query = search.value.trim().toLocaleLowerCase("he");
      let hasMatch = false;
      for (const entry of entries) {
        const matches = entry.dataset.title!.includes(query);
        entry.hidden = !matches;
        hasMatch ||= matches;
      }
      empty.hidden = hasMatch;
    });
  </script>
</Layout>
