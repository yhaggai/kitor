{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kitor",
  "version": "0.1.0",
  "identifier": "haggai",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kitor",
        "width": 800,
        "height": 600,
        "visible": false,
        "label": "main"
      },
      {
        "width": 1536,
        "height": 1024,
        "decorations": false,
        "transparent": true,
        "url": "splashscreen.html",
        "label": "splashscreen",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
