---
import DownloadIcon from "./DownloadIcon.astro";
import Layout from "../layouts/Layout.astro";
import { featured, games } from "../lib/catalog";
import { fallbackInstallerUrl, fallbackReleaseUrl, installers } from "../lib/downloads";
import Box from "./Box";
import Character from "./Character.astro";
import gogLogo from "../../../kitor/public/store-logos/gog.png?url";
import steamLogo from "../../../kitor/public/store-logos/steam.png?url";
import kitorIcon from "../../../kitor/src-tauri/icons/128x128.png?url";

const { locale } = Astro.props as { locale: "he" | "en" };
const en = locale === "en";
const collectionGames = ["grim-fandango-remastered", "owlboy"].map(
  (id) => games.find((game) => game.id === id)!
);
const gameHref = (id: string) => `${en ? "/en" : ""}/games/${id}/`;
const t = (hebrew: string, english: string) => (en ? english : hebrew);
---
<Layout locale={locale} headerStyle="landing"><main id="main"><section class="hero"><div class="scene" aria-hidden="true"></div><div class="hero-content wrap"><div class="hero-copy"><p class="eyebrow">{t("הרפתקאות מוכרות. מילים חדשות.", "Familiar adventures. New words.")}</p><h1>{t("המשחקים שאהבת.", "The games you loved.")}<br/><em>{t("עכשיו בעברית.", "Now in Hebrew.")}</em></h1><p class="lead">{t("קיטור מתקין תרגומים קהילתיים לעברית למשחקים נתמכים מהמחשב, מ־Steam ומ־GOG.", "Kitor installs community Hebrew translations for supported games from your computer, Steam, and GOG.")}</p><div class="actions"><a class="button" id="recommended-download" href="#download"><span>{t("להורדת קיטור", "Download Kitor")}</span> <DownloadIcon/></a><a class="button secondary" href="#download" hidden>{t("כל הגרסאות", "All versions")}</a></div><a class="text-link" href={en ? "/en/games/" : "/games/"}>{t("לכל המשחקים", "Browse all games")} <span aria-hidden="true">{en ? "→" : "←"}</span></a><p class="quiet hero-note">{t("המשחקים שלכם. התרגומים של הקהילה. מקום אחד לכולם.", "Your games and community translations, together.")}</p></div><div class="shelves" aria-label={t("מבחר מתוך ספריית המשחקים", "Featured games from the library")}><div class="shelf">{featured.slice(0,3).map(game => <Box locale={locale} title={game.title} covers={game.covers} href={gameHref(game.id)} client:load />)}</div><div class="shelf lower">{featured.slice(3).map(game => <Box locale={locale} title={game.title} covers={game.covers} href={gameHref(game.id)} client:load />)}</div><p class="shelf-caption">{t("העבירו את העכבר כדי להפוך קופסה · לחצו כדי לפתוח את עמוד המשחק", "Hover to turn a box around · Click to open the game page")}</p></div></div><Character kind="pirate" side="left"/></section>
<section id="how" class="section how">
  <div class="wrap">
    <p class="eyebrow">{t("פחות הגדרות, יותר הרפתקאות", "Less setup, more adventure")}</p>
    <h2>{t("מוסיפים משחק, וקיטור עושה את הקסם", "Add a game. Kitor does the magic.")}</h2>
    <div class="steps">
      <article>
        <div class="step-icon step-stores" dir="ltr" aria-hidden="true">
          <img src={steamLogo} alt="" width="36" height="36" />
          <span>{t("או", "or")}</span>
          <img src={gogLogo} alt="" width="36" height="36" />
        </div>
        <h3>{t("מוסיפים משחק", "Add a game")}</h3>
        <p>{en
          ? <>Add a supported game from your computer or from your <bdi>Steam</bdi> or <bdi>GOG</bdi> library. Kitor downloads it if needed.</>
          : <>מוסיפים משחק נתמך מהמחשב או מהספרייה שלכם ב־<bdi>Steam</bdi> או ב־<bdi>GOG</bdi>. קיטור מוריד את המשחק במידת הצורך.</>}</p>
      </article>
      <article>
        <div class="step-icon" aria-hidden="true">
          <img src={kitorIcon} alt="" width="52" height="52" />
        </div>
        <h3>{t("קיטור מתקין את התרגום", "Kitor installs the translation")}</h3>
        <p>{t("קיטור מחיל את התרגום לעברית אוטומטית ומגבה את הקבצים שהוא משנה.", "Kitor automatically applies the Hebrew patch and backs up the files it changes.")}</p>
      </article>
      <article>
        <span class="step-icon" aria-hidden="true">✦</span>
        <h3>{t("משחקים בעברית", "Play in Hebrew")}</h3>
        <p>{t("מפעילים את המשחק מתוך קיטור וחוזרים לעולמות שאוהבים.", "Launch the game from Kitor and return to the worlds you love.")}</p>
      </article>
    </div>
  </div>
  <Character kind="tentacle" side="right" />
</section>
<section class="section collection wrap"><div><p class="eyebrow">{t("מדף מלא בזיכרונות", "A shelf full of memories")}</p><h2>{t("איזו הרפתקה", "What adventure")}<br/>{t("נפתח היום?", "will you play today?")}</h2><p class="lead">{t("גלו את המשחקים בקטלוג, ממסע בחלל ועד אי הקופים.", "Explore the catalog, from Space Quest to Monkey Island.")}</p><a class="button secondary" href={en ? "/en/games/" : "/games/"}>{t("לכל המשחקים", "Browse all games")} <span aria-hidden="true">{en ? "→" : "←"}</span></a></div><div class="collection-art">
  {collectionGames.map(game => (
    <Box locale={locale} title={game.title} covers={game.covers} href={gameHref(game.id)} client:visible />
  ))}
</div></section>
<section id="community" class="section community"><div class="wrap narrow"><p class="eyebrow">{t("מאהבה למשחקים. ומאהבה לעברית.", "For the love of games and Hebrew.")}</p><h2>{t("מאחורי כל תרגום,", "Behind every translation")}<br/>{t("יש אנשים שאוהבים את המשחק.", "are people who love the game.")}</h2><p class="lead">{t("קיטור מחבר בין המשחקים שלכם לעבודה של קהילת המתרגמים. הקרדיט על התרגומים שייך ליוצרים שלהם — אנחנו כאן כדי שיהיה קל יותר לגלות אותם ולשחק.", "Kitor brings your games and the work of community translators together. The translators deserve the credit for their work. Kitor makes their translations easier to find and play.")}</p><a class="text-link" href="https://github.com/yhaggai/kitor">{t("להכיר את הפרויקט ב־GitHub ↗", "Explore the project on GitHub ↗")}</a></div><Character kind="space" side="left"/></section>
<section id="download" class="section wrap download" aria-labelledby="download-title">
  <p class="eyebrow">{t("מוכנים לחזור להרפתקה?", "Ready for another adventure?")}</p>
  <h2 id="download-title">{t("המדף שלכם מחכה.", "Your shelf awaits.")}</h2>
  <p class="lead">{t("בחרו את גרסת קיטור המתאימה למחשב שלכם.", "Choose the Kitor version for your computer.")}</p>
  <div class="download-platforms">
    <div id="windows-download" tabindex="-1">
      <h3><bdi>Windows</bdi></h3>
      <a class="button secondary" data-installer={installers[0].id} href={fallbackInstallerUrl(installers[0].id)}>{t("להורדה · ", "Download · ")}<bdi>x64</bdi></a>
      <div><a class="text-link" href="https://github.com/yhaggai/kitor/blob/v1/CODE_SIGNING_POLICY.md" lang="en" dir="ltr">Code signing policy</a></div>
    </div>
    <div id="mac-downloads" tabindex="-1">
      <h3><bdi>macOS</bdi></h3>
      <a class="button secondary" data-installer={installers[1].id} href={fallbackInstallerUrl(installers[1].id)}>{t("להורדה · ", "Download · ")}<bdi>Apple Silicon (ARM64)</bdi></a>
      <a class="button secondary" data-installer={installers[2].id} href={fallbackInstallerUrl(installers[2].id)}>{t("להורדה · ", "Download · ")}<bdi>Intel</bdi></a>
      <p class="quiet">{t("לא בטוחים? בתפריט , פתחו את ״אודות Mac זה״ ובדקו מה מופיע ליד ״שבב״ או ״מעבד״.", "Unsure? Open About This Mac from the  menu and check the Chip or Processor field.")}</p>
    </div>
  </div>
  <a class="text-link" id="app-releases" href={fallbackReleaseUrl}>{t("לעמוד ההפצות ב־GitHub ", "View releases on GitHub ")}<span aria-hidden="true">↗</span></a>
</section>
<section class="faq wrap"><h2>{t("לפני שמתחילים", "Before you start")}</h2><details><summary>{t("האם קיטור כולל את המשחקים?", "Does Kitor include the games?")}</summary><p>{en ? <>You need your own copy of the game. Kitor can download supported games directly from your <bdi>GOG</bdi> or <bdi>Steam</bdi> library, then automatically install the translation.</> : <>לא. צריך עותק משלכם של המשחק. אם כבר יש לכם משחק נתמך בספרייה של <bdi>GOG</bdi> או <bdi>Steam</bdi>, קיטור יכול להוריד אותו עבורכם ישירות מהחנות, בלי שתצטרכו להוריד אותו בנפרד. לאחר מכן קיטור מתקין את התרגום אוטומטית.</>}</p></details><details><summary>{t("האם כל משחק עובד בכל מערכת הפעלה?", "Does every game work on every operating system?")}</summary><p>{t("התמיכה משתנה ממשחק למשחק ומגרסה לגרסה. פרטי התאימות וההתקנה מופיעים באפליקציה.", "Support varies by game and edition. Check the app for compatibility and installation details.")}</p></details><details><summary>{t("אפשר להסיר תרגום?", "Can I remove a translation?")}</summary><p>{t("קיטור מגבה את הקבצים שהתרגום משנה ועוקב אחרי קבצים שנוספו, כדי לאפשר שחזור. מומלץ לסגור את המשחק לפני התקנה או הסרה.", "Kitor backs up changed files and tracks added files so it can restore the original game. Close the game before installing or removing a translation.")}</p></details>
  <details>
    <summary>{t("האם בטוח להתקין את קיטור?", "Is it safe to install Kitor?")}</summary>
    <p>{t("קיטור היא אפליקציה בקוד פתוח ברישיון MIT. אפשר לעיין בקוד האפליקציה ובתהליך שבו אנחנו בונים את קבצי ההתקנה. מומלץ להוריד את קיטור דרך האתר הרשמי.", "Kitor is open-source software released under the MIT license. You can review the source code and see how the installers are built. We recommend downloading Kitor through the official website.")} <a class="text-link" href="https://github.com/yhaggai/kitor">{t("קוד המקור ב־GitHub", "Source code on GitHub")}</a></p>
    <p>{t("בדיקות אבטחה אוטומטיות רצות ב־GitHub בכל בקשת מיזוג לענף הראשי ובכל עדכון שלו. CodeQL סורק את קוד המקור, OSV-Scanner בודק אם יש חולשות מוכרות בתלויות, ו־zizmor בודק את הגדרות GitHub Actions. סריקות הקוד והתלויות רצות גם באופן מתוזמן.", "Automated security checks run on GitHub for every pull request targeting the main branch and every push to it. CodeQL scans the source code, OSV-Scanner checks dependencies for known vulnerabilities, and zizmor audits GitHub Actions workflows. The source and dependency scans also run on a schedule.")}</p>
    <p>
      <a class="text-link" href="https://github.com/yhaggai/kitor/actions/workflows/codeql.yml">CodeQL</a>
      · <a class="text-link" href="https://github.com/yhaggai/kitor/actions/workflows/osv-scanner.yml">OSV-Scanner</a>
      · <a class="text-link" href="https://github.com/yhaggai/kitor/actions/workflows/zizmor.yml">zizmor</a>
    </p>
  </details>
</section></main></Layout>

<script>
  import { detectDownload, installers, latestInstallers, releasesUrl } from "../lib/downloads";

  const recommended = document.querySelector<HTMLAnchorElement>("#recommended-download");
  const label = recommended?.querySelector("span");
  const allVersions = document.querySelector<HTMLAnchorElement>("#recommended-download + a");
  const releaseLink = document.querySelector<HTMLAnchorElement>("#app-releases");
  const { gtag } = window as Window & {
    gtag?: (command: "event", name: string, parameters: Record<string, string>) => void;
  };
  const trackInstallerClick = (event: MouseEvent) => {
    if (event.type === "auxclick" && event.button !== 1) return;
    const link = event.target instanceof Element
      ? event.target.closest<HTMLAnchorElement>("a[data-installer]")
      : null;
    if (!link?.dataset.installer) return;
    gtag?.("event", "installer_download", {
      installer_platform: link.dataset.installer,
      page_language: document.documentElement.lang,
    });
  };
  if (gtag) {
    document.addEventListener("click", trackInstallerClick);
    document.addEventListener("auxclick", trackInstallerClick);
  }

  const published = latestInstallers().catch(() => undefined);

  void published.then((release) => {
    if (!release) return;
    for (const [id, url] of release.urls) {
      const link = document.querySelector<HTMLAnchorElement>(`[data-installer="${id}"]`);
      if (link) link.href = url;
    }
    if (releaseLink) releaseLink.href = `${releasesUrl}/tag/app-v${release.version.join(".")}`;
  });

  void detectDownload(navigator).then(async (detected) => {
    if (!detected || !recommended || !label) return;
    const mac = detected === "mac" || detected.startsWith("darwin-");
    const installer = installers.find(({ id }) => id === detected);
    label.replaceChildren(document.documentElement.lang === "en" ? "Download for " : "הורדה ל־");
    const platform = document.createElement("bdi");
    platform.textContent = installer?.label ?? (mac ? "macOS" : "Windows");
    label.append(platform);
    recommended.href = mac ? "#mac-downloads" : "#windows-download";
    if (allVersions) allVersions.hidden = false;

    const url = installer && (await published)?.urls.get(installer.id);
    if (installer && url) {
      recommended.href = url;
      recommended.dataset.installer = installer.id;
    }
  });
</script>
