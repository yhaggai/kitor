
# Preserve upstream patch bytes on every checkout, including Windows.
patches-workspace/** -text
patches-workspace/**/*.json text eol=lf
patches-workspace/**/*.md text eol=lf
patches-workspace/**/*.py text eol=lf
patches-workspace/moomin-midsummer-madness/he/catalog.csv whitespace=-trailing-space
patches-workspace/drifter/he/translation-catalog.csv whitespace=cr-at-eol,-blank-at-eol
# These CSVs retain quoted whitespace and CRLF record separators byte-for-byte.
patches-workspace/disco-elysium/he/translations.csv whitespace=cr-at-eol,-blank-at-eol
patches-workspace/owlboy/he/source/translations/catalog.csv whitespace=cr-at-eol,-blank-at-eol
patches-workspace/undertale/he*/translation-catalog.csv whitespace=cr-at-eol,-blank-at-eol
patches-workspace/**/payload/** binary
patches-workspace/**/upstream/** binary
kitor/patches/registry.json text eol=lf
