{
  "name": "kitor-root",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "kitor",
    "packages/ui"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "lint:staged": "biome check --staged --no-errors-on-unmatched .",
    "storybook": "bun run --cwd packages/ui storybook",
    "storybook:build": "bun run --cwd packages/ui build-storybook",
    "ui:check": "bun run --cwd packages/ui typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@evilmartians/lefthook": "^2.0.13"
  }
}
