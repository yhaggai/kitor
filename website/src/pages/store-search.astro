---
import Layout from "../layouts/Layout.astro";
import { games } from "../lib/catalog";
const catalog = [...games].sort((a, b) => a.title.localeCompare(b.title));
---
<Layout locale="en" title="Store search · Kitor" logoOnlyHeader headerStyle="landing" noindex>
  <main id="main" class="wrap search-page">
    <p class="eyebrow">KITOR LAB · STORE SEARCH</p>
    <h1>Find your next adventure.</h1>
    <p class="lead">Choose a Kitor game to compare CheapShark offers or search G2A’s marketplace.</p>
    <p class="quiet">Research prototype · Prices in USD · These links do not earn Kitor a commission.</p>
    <div class="search-layout">
      <section class="picker" aria-label="Kitor games">
        <label for="game-filter">Search the Kitor catalog</label>
        <input id="game-filter" type="search" placeholder="English or Hebrew title…" />
        <p id="game-count" class="quiet" role="status">{catalog.length} games</p>
        <div class="game-list">
          {catalog.map((game) => <button type="button" class="game-choice" data-id={game.id} data-title={game.title} data-hebrew={game.title_he ?? ""} data-steam={game.steamAppId} aria-pressed="false">
            <strong>{game.title}</strong>
            {game.title_he && <span dir="rtl">{game.title_he}</span>}
          </button>)}
        </div>
      </section>
      <section class="results" aria-label="Store results" aria-busy="false">
        <h2 id="selected-title">Select a game</h2>
        <aside id="g2a-search" hidden aria-label="G2A marketplace search">
          <a id="g2a-link" class="text-link" target="_blank" rel="noopener noreferrer">Search G2A ↗</a>
          <p class="quiet">Opens marketplace search in a new tab; G2A prices are not loaded here. Check the seller, edition, activation region, and whether the listing is a key or an account.</p>
        </aside>
        <p id="search-status" role="status">Store offers will appear here.</p>
        <button type="button" id="retry" hidden>Retry search</button>
        <div id="matches"></div>
        <div id="offers"></div>
        <p class="quiet result-note">No offer returned does not mean a store does not sell the game. Coverage and prices may be incomplete or delayed. Confirm the edition, activation region, and Hebrew patch compatibility before buying.</p>
        <p class="quiet">Price data and purchase links: <a class="text-link" href="https://www.cheapshark.com/">CheapShark</a>. <a class="text-link" href="https://isthereanydeal.com/">Also explore IsThereAnyDeal</a>.</p>
      </section>
    </div>
    <noscript>Enable JavaScript to search stores.</noscript>
  </main>
</Layout>

<script>
  import { findGames, loadOffers, groupOffers, dealUrl } from "../lib/store-search";
  const choices = [...document.querySelectorAll<HTMLButtonElement>(".game-choice")];
  const filter = document.querySelector<HTMLInputElement>("#game-filter")!;
  const status = document.querySelector<HTMLElement>("#search-status")!;
  const heading = document.querySelector<HTMLElement>("#selected-title")!;
  const matches = document.querySelector<HTMLElement>("#matches")!;
  const offers = document.querySelector<HTMLElement>("#offers")!;
  const results = document.querySelector<HTMLElement>(".results")!;
  const retry = document.querySelector<HTMLButtonElement>("#retry")!;
  const g2aSearch = document.querySelector<HTMLElement>("#g2a-search")!;
  const g2aLink = document.querySelector<HTMLAnchorElement>("#g2a-link")!;
  let controller: AbortController | undefined;
  let selected: HTMLButtonElement | undefined;
  const money = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });

  filter.addEventListener("input", () => {
    const query = filter.value.trim().toLocaleLowerCase();
    for (const button of choices) button.hidden = !`${button.dataset.title} ${button.dataset.hebrew}`.toLocaleLowerCase().includes(query);
    document.querySelector("#game-count")!.textContent = `${choices.filter((button) => !button.hidden).length} games`;
  });

  async function showOffers(id: string, signal: AbortSignal) {
    matches.replaceChildren();
    status.textContent = "Loading store offers…";
    results.setAttribute("aria-busy", "true");
    const [game, stores] = await loadOffers(id, signal);
    if (signal.aborted) return;
    const rows = groupOffers(stores, game.deals);
    const available = rows.filter((row) => row.deals.length).length;
    status.textContent = `${game.info.title} · ${available} stores with offers · Retrieved ${new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}. Prices may be cached by the provider.`;
    for (const row of rows) {
      const card = document.createElement("article");
      card.className = "store-row";
      const name = document.createElement("h3");
      name.textContent = row.storeName;
      card.append(name);
      if (!row.deals.length) {
        const empty = document.createElement("span");
        empty.className = "quiet";
        empty.textContent = "No offer returned";
        card.append(empty);
      }
      for (const deal of row.deals) {
        const link = document.createElement("a");
        link.className = "text-link";
        link.href = dealUrl(deal.dealID);
        link.target = "_blank";
        link.rel = "noopener noreferrer sponsored";
        link.textContent = `${money.format(Number(deal.price))} · View offer ↗`;
        link.setAttribute("aria-label", `${row.storeName}: ${money.format(Number(deal.price))}, opens in a new tab`);
        card.append(link);
      }
      offers.append(card);
    }
    results.setAttribute("aria-busy", "false");
  }

  function failure(error: unknown, signal: AbortSignal) {
    if (signal.aborted) return;
    offers.replaceChildren();
    status.textContent = error instanceof Error && error.name !== "TypeError" ? error.message : "Could not reach the price provider. Check your connection and retry.";
    results.setAttribute("aria-busy", "false");
    retry.hidden = false;
  }

  async function select(button: HTMLButtonElement) {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    selected = button;
    for (const choice of choices) choice.setAttribute("aria-pressed", String(choice === button));
    heading.textContent = button.dataset.title!;
    const g2aUrl = new URL("https://www.g2a.com/search");
    g2aUrl.searchParams.set("query", button.dataset.title!);
    g2aLink.href = g2aUrl.href;
    g2aLink.setAttribute("aria-label", `Search G2A for ${button.dataset.title}, opens in a new tab`);
    g2aSearch.hidden = false;
    offers.replaceChildren();
    matches.replaceChildren();
    retry.hidden = true;
    results.setAttribute("aria-busy", "true");
    status.textContent = "Finding matching games…";
    history.replaceState(null, "", `?game=${encodeURIComponent(button.dataset.id!)}`);
    try {
      const found = await findGames({ title: button.dataset.title!, steamAppId: button.dataset.steam ? Number(button.dataset.steam) : undefined }, signal);
      if (signal.aborted) return;
      if (!found.length) {
        status.textContent = "No matching game found in the provider’s catalog. Try another Kitor game.";
        results.setAttribute("aria-busy", "false");
      } else if (found.length === 1 && button.dataset.steam && found[0].steamAppID === button.dataset.steam) {
        await showOffers(found[0].gameID, signal);
      } else {
        status.textContent = "Choose the correct game and edition from these search matches:";
        results.setAttribute("aria-busy", "false");
        for (const match of found) {
          const candidate = document.createElement("button");
          candidate.type = "button";
          candidate.className = "game-choice";
          candidate.textContent = match.external;
          candidate.addEventListener("click", () => { void showOffers(match.gameID, signal).catch((error) => failure(error, signal)); });
          matches.append(candidate);
        }
      }
    } catch (error) { failure(error, signal); }
  }
  for (const button of choices) button.addEventListener("click", () => { void select(button); });
  retry.addEventListener("click", () => { if (selected) void select(selected); });
  const initial = new URLSearchParams(location.search).get("game");
  const initialButton = choices.find((button) => button.dataset.id === initial);
  if (initialButton) void select(initialButton);
</script>

<style>
  .search-page { padding-block: 52px 80px; }
  .eyebrow { color: var(--teal); letter-spacing: .12em; font-size: .8rem; margin-bottom: 16px; }
  h1 { font-size: clamp(2rem, 5vw, 3.5rem); max-width: 20ch; }
  .lead { margin-block: 20px 12px; }
  .search-layout { display: grid; grid-template-columns: minmax(230px, 1fr) minmax(0, 2fr); gap: 28px; margin-top: 32px; }
  .picker, .results { background: #101b2b; border: 1px solid #304056; border-radius: 12px; padding: 24px; min-width: 0; }
  .picker label { display: block; margin-bottom: 12px; }
  input { width: 100%; padding: 12px; background: #080f1d; color: white; border: 1px solid #52637c; border-radius: 6px; }
  #game-count { margin-block: 12px; }
  .game-list { max-height: 65vh; overflow: auto; }
  :global(.game-choice) { display: block; width: 100%; padding: 14px; text-align: start; color: inherit; background: transparent; border: 1px solid transparent; border-radius: 6px; cursor: pointer; }
  :global(.game-choice[hidden]) { display: none; }
  :global(.game-choice:hover), :global(.game-choice[aria-pressed="true"]) { background: #213548; border-color: var(--teal); }
  :global(.game-choice:focus-visible), input:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .game-choice span { display: block; color: var(--muted); font-size: .85rem; margin-top: 5px; }
  #search-status { margin-block: 18px; }
  #g2a-search { margin-top: 18px; padding: 16px; border: 1px solid #52637c; border-radius: 6px; }
  #g2a-search p { margin-top: 8px; font-size: .85rem; }
  :global(.store-row) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding-block: 18px; border-bottom: 1px solid #304056; }
  :global(.store-row h3) { font-size: 1rem; }
  .result-note { margin-block: 28px 14px; font-size: .88rem; }
  #retry { padding: 10px 18px; cursor: pointer; }
  @media (max-width: 700px) { .search-layout { grid-template-columns: 1fr; } .game-list { max-height: 260px; } .picker, .results { padding: 18px; } }
</style>
