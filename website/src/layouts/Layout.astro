---
import kitorLogo from "../../../packages/ui/src/assets/kitor-logo.svg?url";
import "../styles/global.css";
interface Props {
  locale?: "he" | "en";
  page?: "games";
  title?: string;
  description?: string;
}
const { locale = "he", page } = Astro.props;
const en = locale === "en";
const home = en ? "/en/" : "/";
const otherHome = en ? "/" : "/en/";
const alternate = page === "games" ? otherHome + "games/" : otherHome;
const t = (he: string, english: string) => (en ? english : he);
const {
  title = t("קיטור — המשחקים שאהבת. עכשיו בעברית.", "Kitor — The games you loved, now in Hebrew."),
  description = t(
    "ספריית המשחקים והתרגומים שלכם, במקום אחד. גלו את המשחקים הנתמכים בקיטור.",
    "Your games and translations in one place. Explore the games supported by Kitor."
  ),
} = Astro.props;
---
<!doctype html><html lang={locale} dir={en ? "ltr" : "rtl"}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#080f1d"/><meta name="description" content={description}/><title>{title}</title><link rel="icon" href="/favicon.svg"/></head><body><a class="skip" href="#main">{t("דלגו לתוכן", "Skip to content")}</a><header class="nav wrap"><a class="brand" href="/" aria-label="קיטור — הבית"><span class="steam">♨</span> קיטור</a><nav aria-label={t("ניווט ראשי", "Main navigation")}><a href={home + "games/"}>{t("משחקים", "Games")}</a><a href={home + "#how"}>{t("איך זה עובד", "How it works")}</a><a href={home + "#community"}>{t("הקהילה", "Community")}</a></nav><div class="nav-actions"><a class="language-switch" href={alternate} lang={en ? "he" : "en"} hreflang={en ? "he" : "en"}>{t("English", "עברית")}</a><a class="button small" href={home + "#download"}>{t("הורדה", "Download")} <span aria-hidden="true">↓</span></a></div></header><slot/><footer class="wrap footer"><a class="brand" href={home} aria-label={t("קיטור — הבית", "Kitor — Home")}><img src={kitorLogo} alt="" width="96" height="48" /></a><span>{t("עוד הרפתקה אחת, בשפה שלנו.", "One more adventure, in our language.")}</span><a href="https://github.com/yhaggai/kitor">{t("הפרויקט ב־GitHub ↗", "Project on GitHub ↗")}</a><a href="https://github.com/yhaggai/kitor/blob/v1/CODE_SIGNING_POLICY.md" lang="en" dir="ltr">Code signing policy</a><a href="https://github.com/yhaggai/kitor/blob/v1/PRIVACY.md">{t("פרטיות יישום המחשב", "Desktop app privacy")}</a></footer><script>
const observer = new IntersectionObserver(entries => { for (const entry of entries) entry.target.classList.toggle('in-view', entry.isIntersecting); }, { threshold: 0.15 });
document.querySelectorAll('.character').forEach(el => observer.observe(el));
</script></body></html>
